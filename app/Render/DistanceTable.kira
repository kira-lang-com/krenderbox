import Foundation

// RB::Device::distance_texture: (anonymous namespace)::distance_data, a 16 by
// 16 R16Float table of the distance from a pixel's centre to the edge
// crossing it, by the pixel's coverage across and, down, the ratio of the
// edge normal's smaller part to its larger. The halves' bits, row by row.
namespace DistanceTable {
    let side: UN32 = 16
    // A half's 1, the alpha each texel is given.
    let halfOne: UN16 = 0x3c00
    let bits: [UN16] = [
        0x377f, 0x367f, 0x357f, 0x347f, 0x32ff, 0x30ff, 0x2dff, 0x27ff,
        0xa7ff, 0xadff, 0xb0ff, 0xb2ff, 0xb47f, 0xb57f, 0xb67f, 0xb77f,
        0x377e, 0x3679, 0x357a, 0x347b, 0x32f8, 0x30fa, 0x2df9, 0x27f7,
        0xa7f7, 0xadf9, 0xb0fa, 0xb2f8, 0xb47b, 0xb57a, 0xb679, 0xb77e,
        0x3794, 0x366c, 0x356f, 0x3472, 0x32eb, 0x30f1, 0x2dee, 0x27e7,
        0xa7e7, 0xadee, 0xb0f1, 0xb2eb, 0xb472, 0xb56f, 0xb66c, 0xb794,
        0x37b2, 0x365c, 0x355f, 0x3465, 0x32d7, 0x30e2, 0x2ddd, 0x27d1,
        0xa7d1, 0xaddd, 0xb0e2, 0xb2d7, 0xb465, 0xb55f, 0xb65c, 0xb7b2,
        0x37d3, 0x3655, 0x354b, 0x3455, 0x32bd, 0x30d0, 0x2dc7, 0x27b3,
        0xa7b4, 0xadc7, 0xb0d0, 0xb2bd, 0xb455, 0xb54b, 0xb655, 0xb7d3,
        0x37f3, 0x3653, 0x3535, 0x3441, 0x329f, 0x30ba, 0x2dad, 0x2791,
        0xa791, 0xadad, 0xb0ba, 0xb29f, 0xb441, 0xb535, 0xb653, 0xb7f3,
        0x3808, 0x3655, 0x3524, 0x342b, 0x327c, 0x30a2, 0x2d8f, 0x2769,
        0xa769, 0xad8f, 0xb0a2, 0xb27c, 0xb42b, 0xb524, 0xb655, 0xb808,
        0x3814, 0x3658, 0x3518, 0x3414, 0x3257, 0x3087, 0x2d6f, 0x273e,
        0xa73e, 0xad6f, 0xb087, 0xb257, 0xb414, 0xb518, 0xb658, 0xb814,
        0x381f, 0x365c, 0x3510, 0x3402, 0x322f, 0x306a, 0x2d4c, 0x2711,
        0xa711, 0xad4c, 0xb06a, 0xb22f, 0xb402, 0xb510, 0xb65c, 0xb81f,
        0x3828, 0x365f, 0x3509, 0x33e7, 0x3206, 0x304d, 0x2d29, 0x26e1,
        0xa6e1, 0xad29, 0xb04d, 0xb206, 0xb3e7, 0xb509, 0xb65f, 0xb828,
        0x382f, 0x3663, 0x3505, 0x33d2, 0x31e7, 0x302e, 0x2d04, 0x26b0,
        0xa6b0, 0xad04, 0xb02e, 0xb1e7, 0xb3d2, 0xb505, 0xb663, 0xb82f,
        0x3835, 0x3665, 0x3502, 0x33c2, 0x31cf, 0x3011, 0x2cdf, 0x267f,
        0xa67f, 0xacdf, 0xb011, 0xb1cf, 0xb3c2, 0xb502, 0xb665, 0xb835,
        0x3839, 0x3667, 0x3500, 0x33b7, 0x31be, 0x2ff5, 0x2cba, 0x264e,
        0xa64e, 0xacba, 0xaff5, 0xb1be, 0xb3b7, 0xb500, 0xb667, 0xb839,
        0x383c, 0x3669, 0x34fe, 0x33b0, 0x31b3, 0x2fd7, 0x2c98, 0x261d,
        0xa61d, 0xac98, 0xafd7, 0xb1b3, 0xb3b0, 0xb4fe, 0xb669, 0xb83c,
        0x383d, 0x366a, 0x34fe, 0x33ab, 0x31ac, 0x2fc4, 0x2c82, 0x25ee,
        0xa5ee, 0xac82, 0xafc4, 0xb1ac, 0xb3ab, 0xb4fe, 0xb66a, 0xb83d,
        0x383e, 0x366a, 0x34fd, 0x33a9, 0x31a9, 0x2fbc, 0x2c78, 0x25c5,
        0xa5c5, 0xac78, 0xafbc, 0xb1a9, 0xb3a9, 0xb4fd, 0xb66a, 0xb83e
    ]
}

// The table as Rgba16Float texels: the distance in red, little-endian.
function distanceTableTexels() -> [UN8] {
    var bytes: [UN8] = []
    for half in DistanceTable.bits {
        bytes.append(UN8(half & 0xff))
        bytes.append(UN8(half >> 8))
        for _ in 0..2 {
            bytes.append(0)
            bytes.append(0)
        }
        bytes.append(UN8(DistanceTable.halfOne & 0xff))
        bytes.append(UN8(DistanceTable.halfOne >> 8))
    }
    return bytes
}
